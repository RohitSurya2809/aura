# Aura Configuration
AURA_ENVIRONMENT=development
AURA_DEBUG=false

# Database
AURA_DB_HOST=localhost
AURA_DB_PORT=5432
AURA_DB_USER=postgres
AURA_DB_PASSWORD=root
AURA_DB_NAME=aura

# Logging
AURA_LOG_LEVEL=INFO
AURA_LOG_FORMAT=console

# Gemini (optional)
# AURA_GEMINI_API_KEY=your-key-here
# AURA_GEMINI_MODEL=gemini-2.0-flash

# OpenRouter (optional)
# AURA_OPENROUTER_API_KEY=your-key-here
# AURA_OPENROUTER_MODEL=anthropic/claude-sonnet-4
